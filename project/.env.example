# Mapbox API Token
# Get your token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# FullCAM API Subscription Key
VITE_FULLCAM_SUBSCRIPTION_KEY=your_subscription_key_here

# API Proxy URL
# Development: http://localhost:3001
# Production: Your deployed proxy server URL (e.g., AWS Lambda API Gateway URL)
VITE_API_PROXY_URL=http://localhost:3001

# Geoscape API Key
VITE_GEOSCAPE_API_KEY=your_geoscape_api_key_here

# SILO (Scientific Information for Land Owners) weather API credentials
# Register at https://www.longpaddock.qld.gov.au/silo/ - "password" is always the literal
# string "apirequest" per SILO's own API docs, it's not a real secret.
VITE_SILO_API_USERNAME=your_registered_email_here
VITE_SILO_API_PASSWORD=apirequest
